<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.parcial3.viewController.PedidosViewController">
    <padding>
        <Insets bottom="18.0" left="40.0" right="40.0" top="18.0" />
    </padding>
    <children>
        <BorderPane>
            <left>
                <Button onAction="#onRegresar" styleClass="boton-regresar" text="Regresar" />
            </left>
            <center>
                <Label styleClass="titulo" text="Gestión de Pedidos" />
            </center>
            <right>
                <Region prefWidth="75.0" />
            </right>
        </BorderPane>

        <GridPane hgap="20.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="240.0" prefWidth="240.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label styleClass="etiqueta" text="Código:" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label styleClass="etiqueta" text="Nombre Cliente:" GridPane.rowIndex="1" />
                <TextField fx:id="txtCliente" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="etiqueta" text="Tipo Pan:" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbTipoPan" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="etiqueta" text="Cantidad:" GridPane.rowIndex="3" />
                <Spinner fx:id="spCantidad" editable="true" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>

        <Label styleClass="nota" text="El estado, el empleado asignado y los minutos reservados los calcula el sistema al asignar el pedido." />

        <HBox alignment="CENTER" spacing="40.0">
            <children>
                <Button onAction="#onAsignar" styleClass="boton-azul" text="Asignar Pedido" />
                <Button onAction="#onAgregar" styleClass="boton-azul" text="Agregar Pedido" />
            </children>
        </HBox>

        <TableView fx:id="tblPedidos" minHeight="120.0" prefHeight="180.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" />
                <TableColumn fx:id="colCliente" text="Nombre Cliente" />
                <TableColumn fx:id="colTipoPan" text="Tipo Pan" />
                <TableColumn fx:id="colCantidad" text="Cantidad" />
                <TableColumn fx:id="colEstado" text="Estado" />
                <TableColumn fx:id="colCodigoEmpleado" text="Código Empleado" />
                <TableColumn fx:id="colMinutos" text="Minutos Reservados" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER" spacing="40.0">
            <children>
                <Button onAction="#onLimpiar" styleClass="boton-azul" text="Limpiar" />
                <Button onAction="#onCancelar" styleClass="boton-rojo" text="Cancelar Pedido" />
            </children>
        </HBox>
    </children>
</VBox>
